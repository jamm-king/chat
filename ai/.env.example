DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/find_ai
AI_SERVICE_TOKEN=replace-with-a-random-service-token
NOTION_CLIENT_ID=replace-with-notion-client-id
NOTION_CLIENT_SECRET=replace-with-notion-client-secret
NOTION_REDIRECT_URI=http://localhost:8001/integrations/notion/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same key across restarts.
TOKEN_ENCRYPTION_KEY=replace-with-fernet-key
OAUTH_STATE_TTL_SECONDS=600
OAUTH_COOKIE_SECURE=false
NOTION_TIMEOUT_SECONDS=15
NOTION_API_VERSION=2026-03-11
INGESTION_TIMEOUT_SECONDS=600
# Enable after installing pgvector in PostgreSQL and setting the OpenAI API key.
INDEXING_ENABLED=false
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Search and answer generation. Uses the same OpenAI key and embedding configuration.
RAG_ENABLED=false
# GPT-6.0 Luna's official API model ID is gpt-6-luna.
ANSWER_MODEL=gpt-6-luna
ANSWER_PROVIDER_TIMEOUT_SECONDS=40
ANSWER_MAX_OUTPUT_TOKENS=4096
# Conservative UTF-8 context budget; oldest history pairs are removed first.
ANSWER_CONTEXT_BUDGET_BYTES=64000
