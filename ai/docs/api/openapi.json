        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "GENERAL"
                }
              }
            },
            "then": {
              "properties": {
                "status": {
                  "enum": [
                    "ANSWERED",
                    "REFUSED"
                  ]
                },
                "citations": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "RESOURCE"
                },
                "status": {
                  "const": "ANSWERED"
                }
              }
            },
            "then": {
              "properties": {
                "citations": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "INSUFFICIENT_EVIDENCE",
                    "REFUSED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "citations": {
                  "maxItems": 0
                }
              }
            }
          }
        ],
        "description": "동기 생성 결과. answerId 조회·저장·멱등성 없음. context는 현재 질문을 제외한 이력 사용 수와 이력 절단 여부. content는 최대 16,000자 Markdown."
      }
