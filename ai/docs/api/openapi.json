        "description": "history는 완료된 USER/ASSISTANT 쌍, 현재 질문 제외, 오래된 순. message와 합산 32,000자 이하. 입력 예산 초과 시 오래된 쌍부터 제외. GENERAL에서는 resourceIds 금지."
      },
      "AnswerResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "answerId": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "GENERAL",
              "RESOURCE"
            ]
