          "canonicalUrl",
          "chunkCount",
          "indexedAt"
        ]
      },
      "IngestionJob": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "resourceId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "EXTRACTING",
              "INDEXING",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "completedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IngestionResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "jobId",
          "userId",
          "resourceId",
          "status",
          "createdAt",
          "startedAt",
          "completedAt",
          "result",
          "error"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "QUEUED"
                }
              }
            },
            "then": {
              "properties": {
                "startedAt": {
                  "type": "null"
                },
                "completedAt": {
                  "type": "null"
                },
                "result": {
                  "type": "null"
                },
                "error": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "EXTRACTING",
                    "INDEXING"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "startedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "completedAt": {
                  "type": "null"
                },
                "result": {
                  "type": "null"
                },
                "error": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "SUCCEEDED"
                }
              }
            },
            "then": {
              "properties": {
                "startedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "completedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "result": {
                  "$ref": "#/components/schemas/IngestionResult"
                },
                "error": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "FAILED",
                    "CANCELLED"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "completedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "result": {
                  "type": "null"
                },
                "error": {
                  "$ref": "#/components/schemas/JobError"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "CANCELLED"
                }
              }
            },
            "then": {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "const": "RESOURCE_DELETED"
                    },
                    "retryable": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        ],
        "description": "진행: QUEUED → EXTRACTING → INDEXING → SUCCEEDED. 각 진행 상태는 FAILED/CANCELLED로 종료 가능. 종료 상태 불변. 프로세스 실행 중 전체 기한 10분. 작업은 메모리 관리, 재시작 시 유실되며 복구·30일 보존 없음. 완료된 검색용 DB 데이터는 유지. references.md 참조."
      },
